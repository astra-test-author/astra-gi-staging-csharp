<Project Sdk="Microsoft.NET.Sdk">
  <!-- A minimal staging TEST game integration (astra-plugins-ops
       dev/game-integrations-plan-merged.md, G3 "Done when"): it logs one line at Awake and does
       nothing else. Never for players: it exists only to rehearse the games catalogue's staging
       done-when, end to end, as a non-owner third-party author would. Built from PUBLIC inputs only
       (BepInEx.Core from nuget.bepinex.dev, UnityEngine.Modules from nuget.org): never the
       game's own files. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>AstraGiStagingCsharp</AssemblyName>
    <RootNamespace>AstraGiStagingCsharp</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <BepInExPluginGuid>astra-test-author.gi-staging-csharp</BepInExPluginGuid>
    <BepInExPluginName>Staging C# Test GI</BepInExPluginName>
    <Version>0.1.2</Version>
    <SteamAppId>1966720</SteamAppId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>

  <!-- The installed-version marker the Astra client reads, beside the plugin. -->
  <Target Name="AstraItemMarker" AfterTargets="Build">
    <WriteLinesToFile File="$(OutDir)astra-item.json" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="{&quot;id&quot;:&quot;$(BepInExPluginGuid)&quot;,&quot;version&quot;:&quot;$(Version)&quot;,&quot;kind&quot;:&quot;game-integration&quot;,&quot;runtime&quot;:&quot;unity-mono&quot;,&quot;loader&quot;:&quot;bepinex5&quot;,&quot;steam_appid&quot;:$(SteamAppId)}" />
  </Target>
</Project>
